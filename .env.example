# Copy to .env and adjust. All values are optional — the app has sane defaults.

# Port the API listens on (inside the container and locally). Default: 8000.
PORT=8000

# Interface to bind. Default: 0.0.0.0 (container) / 127.0.0.1 (scripts/dev.sh).
HOST=0.0.0.0

# CORS allow-list for browser clients. Comma-separated origins, or "*" for any.
# A headless server-to-server API can leave this as "*". Credentials are only
# enabled when an explicit (non-"*") origin list is provided.
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# Playwright browsers location. Leave unset to use the default cache. Set this
# only to point at a specific ms-playwright dir (the Docker image bundles one).
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
